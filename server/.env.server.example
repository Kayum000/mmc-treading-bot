# Copy to server/.env.server and fill the values locally.
# Never commit server/.env.server.

POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
QUOTEX_INGEST_SECRET=USE_THE_EXISTING_MMC_QUOTEX_INGEST_SECRET
QUOTEX_REAL_ASSET=AUDCAD

