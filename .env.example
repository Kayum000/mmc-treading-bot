# Twelve Data Forex API key (DO NOT commit your real key)
TWELVE_DATA_API_KEY=your_api_key_here

# Gemini API key for Chart Scanner (DO NOT commit your real key)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Gemini model override. Default: gemini-3.1-flash-lite
CHART_SCANNER_MODEL=gemini-3.1-flash-lite

# Persistent PostgreSQL database for 24-hour signal performance (DO NOT commit credentials)
DATABASE_URL=postgresql://user:password@host:5432/database

# Example Forex symbol
FOREX_SYMBOL=EUR/USD
